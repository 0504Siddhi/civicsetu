# ================================================================
# CivicSetu — Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ================================================================

# ── Flask Secret Key (REQUIRED in Production) ──────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── Google Gemini Vision API Key (REQUIRED for AI Detection) ──
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# ── Cloudinary Persistent Image Storage (REQUIRED in Production) ─
# Free account at: https://cloudinary.com/
# Option 1: Standard URL (recommended):
CLOUDINARY_URL=
# Option 2: Discrete credentials:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── Database Configuration (OPTIONAL) ──────────────────────────
# Leave blank to use local SQLite (instance/civicsetu.db).
# On Render / PostgreSQL, set your connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Environment & Admin Initialization (OPTIONAL) ─────────────
# FLASK_ENV=development
# ADMIN_EMAIL=admin@civicsetu.in
# ADMIN_PASSWORD=your-secure-admin-password
